<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动主题（本项目唯一 —— v1.1.3 起移除浅色主题）。

      ⚠️ 与 values-night/themes.xml **内容相同**，两份都必须存在。
      原因：本项目恒为深色，但**系统**可能是浅色。
      Android 的资源限定是按"系统配置"选的，不是按应用自己的主题：
      - 系统深色 → 选 values-night/
      - 系统浅色 → 选 values/（**即使应用内部是深色**）

      若只留 values-night/，系统浅色时找不到 windowBackground，
      冷启动会闪一下默认白底。
    -->
    <style name="Theme.BiliV3" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
